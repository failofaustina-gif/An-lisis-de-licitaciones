# --- Supabase (frontend, valores públicos) ---
# URL del proyecto Supabase. Ver: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave "anon" pública. Es segura de exponer en el cliente porque el acceso
# real se controla con Row Level Security (RLS) en las tablas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase (solo backend / scripts, NUNCA exponer en el cliente) ---
# Service role key: bypassea RLS. Se usa exclusivamente desde scripts/bcra
# (ejecutados localmente o en GitHub Actions) para escribir series_observations
# y series_catalog. No debe usarse en código que corre en el browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Scripts Python (opcional) ---
# Timeout en segundos para requests a la API del BCRA.
BCRA_HTTP_TIMEOUT=30
